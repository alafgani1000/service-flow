{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"title": "AutoCare",
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"custom": true,
			"customGradient": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "name": "Base", "slug": "base", "color": "#FFFFFF" },
				{ "name": "Surface", "slug": "surface", "color": "#F4F5F7" },
				{ "name": "Contrast", "slug": "contrast", "color": "#111418" },
				{ "name": "Muted", "slug": "muted", "color": "#5B6470" },
				{ "name": "Border", "slug": "border", "color": "#DDE1E6" },
				{ "name": "Primary", "slug": "primary", "color": "#14181F" },
				{ "name": "Secondary", "slug": "secondary", "color": "#2A313C" },
				{ "name": "Accent", "slug": "accent", "color": "#FF6A13" },
				{ "name": "Accent Contrast", "slug": "accent-contrast", "color": "#111418" },
				{ "name": "Accent Strong", "slug": "accent-strong", "color": "#C2410C" },
				{ "name": "Success", "slug": "success", "color": "#1F7A3A" },
				{ "name": "Danger", "slug": "danger", "color": "#B42318" }
			]
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1240px"
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "name": "Small", "slug": "sm", "shadow": "0 1px 2px rgba(17, 20, 24, 0.06), 0 1px 3px rgba(17, 20, 24, 0.1)" },
				{ "name": "Medium", "slug": "md", "shadow": "0 4px 12px rgba(17, 20, 24, 0.08), 0 2px 4px rgba(17, 20, 24, 0.06)" },
				{ "name": "Large", "slug": "lg", "shadow": "0 16px 40px rgba(17, 20, 24, 0.14)" }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "px", "em", "rem", "%", "vh", "vw" ],
			"spacingSizes": [
				{ "name": "2XS", "slug": "10", "size": "0.25rem" },
				{ "name": "XS", "slug": "20", "size": "0.5rem" },
				{ "name": "S", "slug": "30", "size": "clamp(0.75rem, 0.65rem + 0.5vw, 1rem)" },
				{ "name": "M", "slug": "40", "size": "clamp(1rem, 0.8rem + 1vw, 1.5rem)" },
				{ "name": "L", "slug": "50", "size": "clamp(1.5rem, 1.1rem + 1.5vw, 2.25rem)" },
				{ "name": "XL", "slug": "60", "size": "clamp(2rem, 1.4rem + 2.5vw, 3.5rem)" },
				{ "name": "2XL", "slug": "70", "size": "clamp(3rem, 2rem + 4vw, 5.5rem)" },
				{ "name": "3XL", "slug": "80", "size": "clamp(4rem, 2.5rem + 6vw, 8rem)" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"name": "Heading (condensed sans)",
					"slug": "heading",
					"fontFamily": "\"Barlow Condensed\", \"Roboto Condensed\", \"Arial Narrow\", \"Helvetica Neue\", Arial, sans-serif"
				},
				{
					"name": "Body (system sans)",
					"slug": "body",
					"fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
				},
				{
					"name": "Monospace",
					"slug": "mono",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
				}
			],
			"fontSizes": [
				{ "name": "Small", "slug": "small", "size": "0.875rem", "fluid": false },
				{ "name": "Medium", "slug": "medium", "size": "1.0625rem", "fluid": { "min": "1rem", "max": "1.0625rem" } },
				{ "name": "Large", "slug": "large", "size": "1.375rem", "fluid": { "min": "1.125rem", "max": "1.375rem" } },
				{ "name": "Extra Large", "slug": "x-large", "size": "2rem", "fluid": { "min": "1.5rem", "max": "2rem" } },
				{ "name": "2X Large", "slug": "xx-large", "size": "2.75rem", "fluid": { "min": "2rem", "max": "2.75rem" } },
				{ "name": "Huge", "slug": "huge", "size": "4rem", "fluid": { "min": "2.5rem", "max": "4rem" } }
			]
		},
		"custom": {
			"radius": {
				"sm": "6px",
				"md": "10px",
				"lg": "16px",
				"pill": "999px"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|body",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "var:preset|spacing|40",
			"padding": {
				"left": "var:preset|spacing|40",
				"right": "var:preset|spacing|40"
			}
		},
		"elements": {
			"link": {
				"color": { "text": "currentColor" },
				"typography": { "textDecoration": "underline" },
				":hover": {
					"color": { "text": "var:preset|color|accent-strong" }
				}
			},
			"heading": {
				"color": { "text": "inherit" },
				"typography": {
					"fontFamily": "var:preset|font-family|heading",
					"fontWeight": "800",
					"lineHeight": "1.1",
					"letterSpacing": "-0.01em"
				}
			},
			"h1": { "typography": { "fontSize": "var:preset|font-size|huge" } },
			"h2": { "typography": { "fontSize": "var:preset|font-size|xx-large" } },
			"h3": { "typography": { "fontSize": "var:preset|font-size|x-large", "lineHeight": "1.2" } },
			"h4": { "typography": { "fontSize": "var:preset|font-size|large", "lineHeight": "1.3" } },
			"h5": { "typography": { "fontSize": "var:preset|font-size|medium", "lineHeight": "1.4" } },
			"h6": { "typography": { "fontSize": "var:preset|font-size|small", "lineHeight": "1.4", "textTransform": "uppercase", "letterSpacing": "0.08em" } },
			"button": {
				"color": {
					"background": "var:preset|color|accent",
					"text": "var:preset|color|accent-contrast"
				},
				"border": { "radius": "var:custom|radius|sm" },
				"spacing": {
					"padding": { "top": "0.85em", "bottom": "0.85em", "left": "1.4em", "right": "1.4em" }
				},
				"typography": {
					"fontSize": "var:preset|font-size|medium",
					"fontWeight": "700",
					"lineHeight": "1.2"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|accent-strong",
						"text": "var:preset|color|base"
					}
				},
				":focus": {
					"color": {
						"background": "var:preset|color|accent-strong",
						"text": "var:preset|color|base"
					}
				}
			},
			"caption": {
				"color": { "text": "var:preset|color|muted" },
				"typography": { "fontSize": "var:preset|font-size|small" }
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|heading",
					"fontSize": "var:preset|font-size|large",
					"fontWeight": "800",
					"textTransform": "uppercase",
					"letterSpacing": "0.02em"
				},
				"elements": {
					"link": {
						"typography": { "textDecoration": "none" },
						":hover": { "color": { "text": "currentColor" } }
					}
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "600"
				},
				"elements": {
					"link": {
						"typography": { "textDecoration": "none" },
						":hover": { "typography": { "textDecoration": "underline" } }
					}
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						"typography": { "textDecoration": "none" },
						":hover": { "color": { "text": "var:preset|color|accent-strong" } }
					}
				}
			},
			"core/post-date": {
				"color": { "text": "var:preset|color|muted" },
				"typography": { "fontSize": "var:preset|font-size|small" }
			},
			"core/post-terms": {
				"typography": { "fontSize": "var:preset|font-size|small", "fontWeight": "600" }
			},
			"core/post-featured-image": {
				"border": { "radius": "var:custom|radius|md" }
			},
			"core/image": {
				"border": { "radius": "var:custom|radius|md" }
			},
			"core/details": {
				"border": {
					"color": "var:preset|color|border",
					"style": "solid",
					"width": "1px",
					"radius": "var:custom|radius|md"
				},
				"color": { "background": "var:preset|color|base" },
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|30",
						"bottom": "var:preset|spacing|30",
						"left": "var:preset|spacing|40",
						"right": "var:preset|spacing|40"
					}
				}
			},
			"core/separator": {
				"color": { "text": "var:preset|color|border" }
			},
			"core/quote": {
				"border": {
					"left": { "color": "var:preset|color|accent", "style": "solid", "width": "4px" }
				},
				"spacing": {
					"padding": { "left": "var:preset|spacing|40" }
				}
			},
			"core/search": {
				"border": { "radius": "var:custom|radius|sm" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" },
		{ "name": "mobile-cta", "title": "Mobile Sticky CTA", "area": "uncategorized" },
		{ "name": "breadcrumbs", "title": "Breadcrumbs", "area": "uncategorized" }
	],
	"customTemplates": [
		{ "name": "page-landing", "title": "Landing Page (no title, full width)", "postTypes": [ "page" ] }
	]
}
