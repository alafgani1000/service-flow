{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "serviceflow/breadcrumbs",
	"title": "Breadcrumbs",
	"category": "theme",
	"icon": "arrow-right-alt2",
	"description": "Breadcrumb trail for the current page. Uses Yoast SEO or Rank Math breadcrumbs when they are enabled.",
	"keywords": [ "breadcrumb", "navigation", "trail" ],
	"textdomain": "serviceflow",
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"color": {
			"text": true,
			"link": true,
			"background": false
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true
		}
	},
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
